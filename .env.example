PORT=8080
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/eduquinn
DATABASE_SSL=true
SESSION_DAYS=14
SUPPORT_EMAIL=support@eduquinn.co.zw
SUPPORT_FROM_EMAIL=support@eduquinn.co.zw
BREVO_API_KEY=
ADMIN_EMAIL=admin@eduquinn.co.zw
ADMIN_PASSWORD=ChangeThisImmediately123!
ADMIN_NAME=EduQuinn Administrator

# Local or mounted private media directory (must be persistent in production)
MEDIA_ROOT=./storage/media

INSTRUCTOR_SHARE_PERCENT=75
PAYMENT_SANDBOX=true
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
CARD_PROVIDER=not_configured
BANK_TRANSFER_INSTRUCTIONS=Contact EduQuinn support for bank transfer details.

# Phase 14 communications
# Leave BREVO_API_KEY empty for in-app-only notifications.
# BREVO_API_KEY=your_brevo_api_key

# Phase 15 production hardening
APP_BASE_URL=https://eduquinn.co.zw
ALLOWED_ORIGINS=https://eduquinn.co.zw,https://www.eduquinn.co.zw
TRUST_PROXY=true
API_RATE_LIMIT=300
LOGIN_RATE_LIMIT=10
RATE_WINDOW_MS=300000
BACKUP_DIR=./backups
BACKUP_RETENTION=14
# Optional on Windows if pg_dump is not in PATH:
# PG_DUMP_BIN=C:\\Program Files\\PostgreSQL\\17\\bin\\pg_dump.exe

# Phase 16 launch
PUBLIC_SITE_NAME=EduQuinn
CERTIFICATE_VERIFY_BASE_URL=https://eduquinn.co.zw/verify-certificate.html
LAUNCH_CONTACT_EMAIL=support@eduquinn.co.zw
