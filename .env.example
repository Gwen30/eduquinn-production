# --- Vercel + Supabase (see README-WEB-DEPLOY.md for the full walkthrough) ---
# PORT is no longer used — Vercel runs api/index.js as a serverless function,
# not a long-lived process listening on a port.
NODE_ENV=production

# Use the Supabase project's TRANSACTION POOLER connection string (port 6543,
# NOT the direct 5432 one), with ?workaround=supabase-pooler.vercel appended —
# this is Supabase's own documented requirement for Vercel serverless
# functions, so that many concurrent function invocations don't exhaust
# Postgres' direct-connection limit. Find it in Supabase dashboard -> Project
# Settings -> Database -> Connect -> "Transaction pooler".
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?workaround=supabase-pooler.vercel
DATABASE_SSL=true
# Optional: only set this if you've downloaded Supabase's CA certificate and
# want full certificate validation instead of the default permissive TLS.
# PGSSLROOTCERT=/path/to/supabase-ca.crt
# Optional: per-invocation pool size. Keep this small (1-3) — unlike the old
# single always-on Render process, many serverless invocations can run
# concurrently, each with its own pool.
DB_POOL_MAX=3

SESSION_DAYS=14
SUPPORT_EMAIL=support@eduquinn.co.zw
SUPPORT_FROM_EMAIL=support@eduquinn.co.zw
BREVO_API_KEY=
ADMIN_EMAIL=admin@eduquinn.co.zw
ADMIN_PASSWORD=ChangeThisImmediately123!
ADMIN_NAME=EduQuinn Administrator

# --- Supabase Storage (replaces the old local-disk MEDIA_ROOT) ---
# From Supabase dashboard -> Project Settings -> API.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — set it only as a
# Vercel server-side env var, NEVER exposed to the browser.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional; defaults to "course-media". Create this bucket (private) in
# Supabase dashboard -> Storage before first deploy.
SUPABASE_MEDIA_BUCKET=course-media

# --- Vercel Cron (replaces the old manual "npm run maintenance") ---
# Any long random string. Vercel sends it as "Authorization: Bearer <value>"
# when it invokes the scheduled /api/cron/maintenance function — verify this
# still matches Vercel's current docs when you set this up.
CRON_SECRET=

INSTRUCTOR_SHARE_PERCENT=75
PAYMENT_SANDBOX=true
# Create a free merchant account at https://www.paynow.co.zw to get these. Both the
# "card" and "paynow" checkout options use this one integration — Paynow's own hosted
# payment page is where the customer chooses EcoCash, OneMoney, or a Visa/Mastercard card.
# Leave PAYMENT_SANDBOX=true until these are set AND you have test-paid a real order.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# Optional overrides; default to APP_BASE_URL + the paths below.
# PAYNOW_RESULT_URL=https://eduquinn.co.zw/api/payments/paynow/webhook
# PAYNOW_RETURN_URL=https://eduquinn.co.zw/order-success.html?db=1
CARD_PROVIDER=not_configured
BANK_TRANSFER_INSTRUCTIONS=Contact EduQuinn support for bank transfer details.

# Phase 14 communications
# Leave BREVO_API_KEY empty for in-app-only notifications.
# BREVO_API_KEY=your_brevo_api_key

# Phase 15 production hardening
APP_BASE_URL=https://eduquinn.co.zw
ALLOWED_ORIGINS=https://eduquinn.co.zw,https://www.eduquinn.co.zw
API_RATE_LIMIT=300
LOGIN_RATE_LIMIT=10
RATE_WINDOW_MS=300000
# TRUST_PROXY, BACKUP_DIR, BACKUP_RETENTION and PG_DUMP_BIN are no longer
# used: Vercel has no persistent filesystem for pg_dump to write to, and
# Vercel always reports the real visitor IP via x-forwarded-for, so there is
# no "trust the proxy or not" toggle anymore. See the backup-strategy note in
# README-WEB-DEPLOY.md.

# Phase 16 launch
PUBLIC_SITE_NAME=EduQuinn
CERTIFICATE_VERIFY_BASE_URL=https://eduquinn.co.zw/verify-certificate.html
LAUNCH_CONTACT_EMAIL=support@eduquinn.co.zw
