index 3df23eb..53fef79 100644
--- a/.env.example
+++ b/.env.example
@@ -45,6 +45,18 @@ CRON_SECRET=
 
 INSTRUCTOR_SHARE_PERCENT=75
 PAYMENT_SANDBOX=true
+# Refund policy: a student can self-service request a refund within this
+# many days of paying, as long as no course in the order is more than
+# REFUND_MAX_PROGRESS_PERCENT% complete. EARNINGS_HOLD_DAYS controls how
+# long an instructor's share of a sale is held before it's eligible for
+# payout — it defaults to REFUND_WINDOW_DAYS + 3 and should always be at
+# least as long as REFUND_WINDOW_DAYS, so a payout can never be approved
+# while the matching order could still be refunded. See db/schema.sql's
+# Phase 19 note and /refund-policy.html, which states these numbers to
+# students — update that page's text if you change these.
+REFUND_WINDOW_DAYS=14
+REFUND_MAX_PROGRESS_PERCENT=20
+EARNINGS_HOLD_DAYS=17
 # Create a free merchant account at https://www.paynow.co.zw to get these. Both the
 # "card" and "paynow" checkout options use this one integration — Paynow's own hosted
 # payment page is where the customer chooses EcoCash, OneMoney, or a Visa/Mastercard card.
