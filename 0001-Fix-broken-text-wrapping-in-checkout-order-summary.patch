From f61cd9999ae9abd3604622d004be6a14163ccb40 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 18 Nov 2026 21:12:48 +0200
Subject: [PATCH] Fix broken text wrapping in checkout order summary

.summary-course's CSS expects 3 grid columns (42px icon, 1fr text, auto
price), but the row markup only emitted 2 children (a text div + price),
so the title/instructor text was squeezed into the 42px icon column and
wrapped letter-by-letter. Added the missing icon span to match the CSS.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0117Yza2cLL621d3pHBjry2q
---
 public/payments.js | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/public/payments.js b/public/payments.js
index d9f3817..a8279f6 100644
--- a/public/payments.js
+++ b/public/payments.js
@@ -7,7 +7,7 @@ async function checkout(){
  const vatPercent=Number(config.vatPercent||0),exemptLevels=new Set((config.vatExemptEducationLevels||[]).map(v=>String(v).toLowerCase()));
  const qs=new URLSearchParams(location.search),requested=qs.getAll('course'); let selected=new Set(requested);
  const root=document.querySelector('#pageContent');
- const render=()=>{const picked=catalog.courses.filter(c=>selected.has(c.id));const subtotal=picked.reduce((a,c)=>a+Number(c.price_cents),0);const taxableSubtotal=picked.reduce((a,c)=>a+(exemptLevels.has(String(c.education_level||'').toLowerCase())?0:Number(c.price_cents)),0);const taxCents=Math.round(taxableSubtotal*vatPercent/100);const total=subtotal+taxCents;root.innerHTML=`<div class="checkout-layout phase12-checkout"><section class="panel checkout-form"><p class="eyebrow">CHECKOUT</p><h1>Secure checkout</h1><p>Review your selected courses and payment method.</p><div class="db-course-list">${catalog.courses.length?catalog.courses.map(c=>`<label class="db-course-option"><input type="checkbox" value="${c.id}" ${selected.has(c.id)?'checked':''}><span><b>${esc(c.title)}</b><small>${esc(c.instructor_name||'EduQuinn Instructor')} · ${esc(c.education_level)}</small></span><strong>${fmt(c.price_cents)}</strong></label>`).join(''):'<div class="empty-state"><b>No published database courses yet.</b><p>Ask an instructor to create and publish a course first.</p></div>'}</div><div class="coupon-row"><input id="couponCode" placeholder="Coupon code"><button class="btn btn-ghost" id="applyCoupon" type="button">Apply</button></div><small id="couponMsg"></small><h2>Payment method</h2><div class="payment-options">${config.methods.map((m,i)=>`<label class="payment-option ${!m.configured&&m.id!=='bank_transfer'?'payment-unconfigured':''}"><input type="radio" name="payment" value="${m.id}" ${i===config.methods.length-1?'checked':''}><span class="payment-icon">${m.id==='bank_transfer'?'🏦':m.id==='paynow'?'📱':'💳'}</span><span class="payment-copy"><b>${esc(m.label)}</b><small>${m.configured?'Available':'Unavailable'}</small></span></label>`).join('')}</div><button class="btn btn-primary btn-full" id="placeOrder" ${picked.length?'':'disabled'}>Place order · ${fmt(total)}</button><p class="secure-note">Your order will be processed using the selected available payment method. Refunds are available within ${config.refundWindowDays||14} days of purchase, as long as you haven't completed more than ${config.refundMaxProgressPercent||20}% of the course — see our <a href="/refund-policy.html" target="_blank" rel="noopener">Refund Policy</a>.</p></section><aside class="panel order-summary"><h2>Order summary</h2>${picked.map(c=>`<div class="summary-course"><div><b>${esc(c.title)}</b><small>${esc(c.instructor_name||'Instructor')}</small></div><strong>${fmt(c.price_cents)}</strong></div>`).join('')||'<p>Select a course to continue.</p>'}<div class="summary-total"><span>Subtotal</span><strong>${fmt(subtotal)}</strong></div>${vatPercent>0?`<div class="summary-total"><span>VAT (${vatPercent}%)</span><strong>${fmt(taxCents)}</strong></div>`:''}<div class="summary-total"><span>Total</span><strong>${fmt(total)}</strong></div></aside></div>`;
+ const render=()=>{const picked=catalog.courses.filter(c=>selected.has(c.id));const subtotal=picked.reduce((a,c)=>a+Number(c.price_cents),0);const taxableSubtotal=picked.reduce((a,c)=>a+(exemptLevels.has(String(c.education_level||'').toLowerCase())?0:Number(c.price_cents)),0);const taxCents=Math.round(taxableSubtotal*vatPercent/100);const total=subtotal+taxCents;root.innerHTML=`<div class="checkout-layout phase12-checkout"><section class="panel checkout-form"><p class="eyebrow">CHECKOUT</p><h1>Secure checkout</h1><p>Review your selected courses and payment method.</p><div class="db-course-list">${catalog.courses.length?catalog.courses.map(c=>`<label class="db-course-option"><input type="checkbox" value="${c.id}" ${selected.has(c.id)?'checked':''}><span><b>${esc(c.title)}</b><small>${esc(c.instructor_name||'EduQuinn Instructor')} · ${esc(c.education_level)}</small></span><strong>${fmt(c.price_cents)}</strong></label>`).join(''):'<div class="empty-state"><b>No published database courses yet.</b><p>Ask an instructor to create and publish a course first.</p></div>'}</div><div class="coupon-row"><input id="couponCode" placeholder="Coupon code"><button class="btn btn-ghost" id="applyCoupon" type="button">Apply</button></div><small id="couponMsg"></small><h2>Payment method</h2><div class="payment-options">${config.methods.map((m,i)=>`<label class="payment-option ${!m.configured&&m.id!=='bank_transfer'?'payment-unconfigured':''}"><input type="radio" name="payment" value="${m.id}" ${i===config.methods.length-1?'checked':''}><span class="payment-icon">${m.id==='bank_transfer'?'🏦':m.id==='paynow'?'📱':'💳'}</span><span class="payment-copy"><b>${esc(m.label)}</b><small>${m.configured?'Available':'Unavailable'}</small></span></label>`).join('')}</div><button class="btn btn-primary btn-full" id="placeOrder" ${picked.length?'':'disabled'}>Place order · ${fmt(total)}</button><p class="secure-note">Your order will be processed using the selected available payment method. Refunds are available within ${config.refundWindowDays||14} days of purchase, as long as you haven't completed more than ${config.refundMaxProgressPercent||20}% of the course — see our <a href="/refund-policy.html" target="_blank" rel="noopener">Refund Policy</a>.</p></section><aside class="panel order-summary"><h2>Order summary</h2>${picked.map(c=>`<div class="summary-course"><span>${iconSvg('graduation')}</span><div><b>${esc(c.title)}</b><small>${esc(c.instructor_name||'Instructor')}</small></div><strong>${fmt(c.price_cents)}</strong></div>`).join('')||'<p>Select a course to continue.</p>'}<div class="summary-total"><span>Subtotal</span><strong>${fmt(subtotal)}</strong></div>${vatPercent>0?`<div class="summary-total"><span>VAT (${vatPercent}%)</span><strong>${fmt(taxCents)}</strong></div>`:''}<div class="summary-total"><span>Total</span><strong>${fmt(total)}</strong></div></aside></div>`;
  root.querySelectorAll('.db-course-option input').forEach(x=>x.onchange=()=>{x.checked?selected.add(x.value):selected.delete(x.value);render()});
  let applied='';document.querySelector('#applyCoupon').onclick=async()=>{const code=document.querySelector('#couponCode').value.trim();try{const d=await api('/api/coupons/validate',{method:'POST',body:JSON.stringify({code,subtotalCents:subtotal})});applied=d.code||'';document.querySelector('#couponMsg').textContent=d.code?`${d.code} applied — ${fmt(d.discountCents)} discount.`:'No coupon applied.'}catch(e){document.querySelector('#couponMsg').textContent=e.message}};
  document.querySelector('#placeOrder').onclick=async()=>{const btn=document.querySelector('#placeOrder');btn.disabled=true;btn.textContent='Creating order…';try{const paymentMethod=document.querySelector('[name=payment]:checked').value;const d=await api('/api/orders',{method:'POST',body:JSON.stringify({courseIds:[...selected],paymentMethod,couponCode:applied})});sessionStorage.setItem('eduquinnLastDbOrder',JSON.stringify(d));if(d.paynowRedirectUrl){location.href=d.paynowRedirectUrl;return}location.href='/order-success.html?db=1&orderId='+encodeURIComponent(d.order.id)}catch(e){alert(e.message);btn.disabled=false;btn.textContent=`Place order · ${fmt(total)}`}};
