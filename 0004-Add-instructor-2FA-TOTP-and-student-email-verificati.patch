+<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Verify your email — EduQuinn</title><link rel="stylesheet" href="/styles.css"><script src="/icons.js"></script><link rel="icon" href="/favicon.ico" sizes="any"><link rel="icon" href="/app-icon.svg" type="image/svg+xml"><link rel="apple-touch-icon" href="/apple-touch-icon.png"><meta name="theme-color" content="#702632"></head><body class="auth-body"><main class="verify-shell"><a class="brand" href="/"><span class="brand-mark">EQ</span><span><strong>EduQuinn</strong><small>Learn. Grow. Succeed.</small></span></a><section class="verify-card"><p class="eyebrow">EMAIL VERIFICATION</p><h1 id="verifyHeading">Verifying your email…</h1><p id="verifyMessage">Hang on a moment.</p><div id="verifyActions"></div></section></main><script src="/verify-email.js"></script></body></html>
diff --git a/public/verify-email.js b/public/verify-email.js
