<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="EduQuinn"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:name=".EduQuinnApplication"
        android:theme="@style/Theme.EduQuinn">

        <!--
          Fallback target for anything outside the native v1 scope (live
          classes, messaging, notifications, instructor/admin areas,
          purchase history) — kept exactly as before. NativeActivity now
          owns the launcher role and the App Links intent-filter; it
          forwards any URI it doesn't recognize here unchanged
          (see NativeActivity.resolveNativeStartRoute), so this activity's
          own WebView deep-link interception, offline fallback, and
          file-chooser handling still see exactly the same kind of intents
          they always did.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EduQuinn"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.NativeActivity"
            android:exported="true"
            android:theme="@style/Theme.EduQuinn.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="eduquinn.co.zw" />
                <data android:scheme="https" android:host="www.eduquinn.co.zw" />
            </intent-filter>
        </activity>

        <!-- Lets the Certificate screen share a rendered certificate image
             via the system share sheet (content:// URI, not a raw file path). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
