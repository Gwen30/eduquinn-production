<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android 12 (API <31) equivalent of data_extraction_rules.xml - same
  reasoning: eq_secure_prefs can't be meaningfully restored without its
  Android Keystore key, so it's excluded from the old-style full-backup
  path too.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="eq_secure_prefs.xml" />
</full-backup-content>
