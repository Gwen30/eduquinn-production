<?xml version="1.0" encoding="utf-8"?>
<!--
  Used by the FileProvider declared in AndroidManifest.xml so the
  Certificate screen can share a rendered certificate image via the
  system share sheet without exposing a raw file:// path (not allowed on
  API 24+ with a content provider targeting modern targetSdk levels).
-->
<paths>
    <cache-path name="shared_images" path="shared_images/" />
</paths>
